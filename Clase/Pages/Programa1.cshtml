@page
@model CodeBehind.Pages.Programa1Model
@{
    ViewData["Title"] = "Programa1";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-9">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Registro de venta</h4>
                </div>

                <div class="card-body p-4">
                    <form method="post">
                        <!-- Primera fila -->
                        <div class="row g-3">

                            <div class="col-md-6">
                                <label id="lblProducto" for="ddlProducto" class="form-label">Producto</label>
                                <select id="ddlProducto" asp-for="Producto" class="form-select">
                                    <option value="0">Seleccione</option>
                                    <option value="1">Laptop</option>
                                    <option value="2">Mouse inalámbrico</option>
                                    <option value="3">Teclado mecánico</option>
                                    <option value="4">Monitor 24"</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label id="lblCantidad" for="txtCantidad" class="form-label">Cantidad</label>
                                <input id="txtCantidad" asp-for="Cantidad" class="form-control" type="number" />
                            </div>

                            <div class="col-md-6">
                                <label id="lblTipoCliente" for="ddlTipoCliente" class="form-label">Tipo de cliente</label>
                                <select id="ddlTipoCliente" asp-for="TipoCliente" class="form-select">
                                    <option value="0">Seleccione</option>
                                    <option value="1">General</option>
                                    <option value="2">Frecuente</option>
                                    <option value="3">Mayorista</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label id="lblMetodoEnvio" for="ddlMetodoEnvio" class="form-label">Método de envío</label>
                                <select id="ddlMetodoEnvio" asp-for="MetodoEnvio" class="form-select">
                                    <option value="0">Seleccione</option>
                                    <option value="1">Recoger en sucursal</option>
                                    <option value="2">Envío estándar</option>
                                    <option value="3">Envío exprés</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label id="lblDescuento" for="txtDescuento" class="form-label">Descuento</label>
                                <div class="input-group">
                                    <input id="txtDescuento" asp-for="Descuento" class="form-control" type="number" />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label id="lblIVA" for="txtIVA" class="form-label">IVA</label>
                                <div class="input-group">
                                    <input id="txtIVA" asp-for="IVA" class="form-control" type="number" value="16" readonly />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>

                        </div>

                        <!-- Separador -->
                        <hr class="my-4">

                        <!-- Resultado correcto -->
                        @if (!string.IsNullOrEmpty(Model.ResultadoOK))
                        {
                            <div class="alert alert-success mt-2 p-2 text-center">
                                @Html.Raw(Model.ResultadoOK)
                            </div>
                        }

                        <!-- Resultado incorrecto -->
                        @if (!string.IsNullOrEmpty(Model.ResultadoNoOK))
                        {
                            <div class="alert alert-danger mt-2 p-2 text-center">
                                @Html.Raw(Model.ResultadoNoOK)
                            </div>
                        }


                        <!-- Botones -->
                        <div class="d-flex justify-content-end gap-2">
                            <button type="submit" class="btn btn-outline-secondary" asp-page-handler="Limpiar">Limpiar</button>
                            <button type="submit" class="btn btn-primary px-4" asp-page-handler="Guardar">Guardar</button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>