
@page
@model Clase.Pages.Programa2Model
@{
    ViewData["Title"] = "Programa 2 - Servicio de Mantenimiento";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-9">
            <div class="card shadow-sm border-0">
                <div class="card-header text-white" style="background-color: #8c68cd;">
                    <h4 class="mb-0">Servicio de mantenimiento</h4>
                </div>

                <div class="card-body p-4">
                    <form method="post">
                        <!-- Primera Fila -->
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label id="lblTipoServicio" for="ddlTipoServicio" class="form-label">Tipo de servicio</label>
                                <select id="ddlTipoServicio" asp-for="TipoServicio" class="form-select">
                                    <option value="0">Seleccione</option>
                                    <option value="1">Limpieza interna ($350)</option>
                                    <option value="2">Mantenimiento preventivo ($600)</option>
                                    <option value="3">Cambio de pasta térmica ($450)</option>
                                    <option value="4">Formateo e instalación ($800)</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label id="lblTipoEquipo" for="ddlTipoEquipo" class="form-label">Tipo de equipo</label>
                                <select id="ddlTipoEquipo" asp-for="TipoEquipo" class="form-select">
                                    <option value="0">Seleccione</option>
                                    <option value="1">Laptop (+$0)</option>
                                    <option value="2">PC de escritorio (+$100)</option>
                                    <option value="3">All-in-One (+$150)</option>
                                    <option value="4">Mac (+$300)</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label id="lblAntiguedadEquipo" for="txtAntiguedadEquipo" class="form-label">Antigüedad del equipo</label>
                                <div class="input-group">
                                    <input id="txtAntiguedadEquipo" asp-for="AntiguedadEquipo" class="form-control" type="number" />
                                    <span class="input-group-text">años</span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label id="lblNumeroEquipos" for="txtNumeroEquipos" class="form-label">Número de equipos</label>
                                <input id="txtNumeroEquipos" asp-for="NumeroEquipos" class="form-control" type="number" />
                            </div>

                            <div class="col-md-6">
                                <label id="lblGarantiaExtendida" for="ddlGarantiaExtendida" class="form-label">Garantía extendida</label>
                                <select id="ddlGarantiaExtendida" asp-for="GarantiaExtendida" class="form-select">
                                    <option value="0">Seleccione</option>
                                    <option value="1">30 días (+$0)</option>
                                    <option value="2">90 días (+$150)</option>
                                    <option value="3">180 días (+$300)</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label id="lblIVA" for="txtIVA" class="form-label">IVA</label>
                                <div class="input-group">
                                    <input id="txtIVA" asp-for="IVA" class="form-control" type="number" value="16" readonly />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>

                            <!-- Prioridad del servicio (Radio buttons) -->
                            <div class="col-12 mt-4">
                                <label class="form-label d-block">Prioridad del servicio</label>
                                <div class="border rounded p-3 d-flex gap-4">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="PrioridadServicio" id="prioNormal" value="1">
                                        <label class="form-check-label" for="prioNormal">Normal ($0)</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="PrioridadServicio" id="prioUrgente" value="2">
                                        <label class="form-check-label" for="prioUrgente">Urgente ($200)</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="PrioridadServicio" id="prioExpress" value="3">
                                        <label class="form-check-label" for="prioExpress">Express ($400)</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Separador -->
                        <hr class="my-4">

                        <!-- Mensajes de alerta -->
                        @if (!string.IsNullOrEmpty(Model.ResultadoOK))
                        {
                            <div class="alert alert-success mt-2 p-2 text-center">
                                @Html.Raw(Model.ResultadoOK)
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(Model.ResultadoNoOK))
                        {
                            <div class="alert alert-danger mt-2 p-2 text-center">
                                @Html.Raw(Model.ResultadoNoOK)
                            </div>
                        }

                        <!-- Botones -->
                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="submit" class="btn btn-outline-secondary" asp-page-handler="Limpiar">Limpiar</button>
                            <button type="submit" class="btn text-white px-4" style="background-color: #8c68cd;" asp-page-handler="Calcular">Calcular</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>